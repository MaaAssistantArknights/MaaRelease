        "algorithm": "OcrDetect",
        "action": "ClickSelf",
        "text": ["你确定要这么做"],
        "roi": [380, 535, 150, 30],
        "postDelay": 1000,
        "next": ["BlackFlowTemporary@ChooseStrategy", "BlackFlowTemporary@ChooseSpecialSquad", "BlackFlowTemporary@ChooseRecruitVoucher", "BlackFlowTemporary@ChooseMechanic"]
