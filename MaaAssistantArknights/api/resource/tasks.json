        "algorithm": "OcrDetect",
        "action": "ClickRect",
        "text": ["特勤任务影像"],
        "roi": [560, 300, 170, 50],
        "specificRect": [640, 655, 1, 1],
        "postDelay": 500,
        "next": ["BlackFlowTemporary@ChooseSpecialSquad", "#self"]
    },
